---
import type { ArchitectureLayer } from "../../data/projects";

interface Props {
    title: string;
    layers: ArchitectureLayer[];
}

const { title, layers } = Astro.props;
---

<figure class="architecture-pipeline" aria-label={`${title} system architecture`}>
    <ol>
        {layers.map((layer) => (
            <li>
                <div class="layer">
                    <h3>{layer.title}</h3>
                    <div class="nodes" style={`--node-count: ${layer.nodes.length}`}>
                        {layer.nodes.map((node) => (
                            <div class="node">
                                <h4>{node.title}</h4>
                                <p>{node.description}</p>
                            </div>
                        ))}
                    </div>
                </div>
                {layer.connection && (
                    <div class="connection">
                        <span>{layer.connection}</span>
                        <div class="arrow" aria-hidden="true" />
                    </div>
                )}
            </li>
        ))}
    </ol>
    <figcaption>{title} · System architecture and execution flow</figcaption>
</figure>

<style>
    .architecture-pipeline { margin: 0; min-width: 0; }
    ol { list-style: none; margin: 0; padding: 0; }
    .layer { padding: 1.25rem; border: 1px solid #334155; border-radius: 8px; background: #0f172a80; }
    h3 { margin: 0 0 1rem; color: #a5b4fc; font: 500 0.8rem "JetBrains Mono", monospace; }
    .nodes { display: grid; grid-template-columns: repeat(var(--node-count), minmax(0, 1fr)); gap: 0.75rem; }
    .node { padding-left: 1rem; border-left: 2px solid #38bdf8; min-width: 0; }
    .node:nth-child(2) { border-color: #34d399; }
    .node:nth-child(3) { border-color: #fbbf24; }
    .node:nth-child(4) { border-color: #fb7185; }
    h4 { color: #f8fafc; font-size: 0.95rem; font-weight: 600; margin: 0 0 0.4rem; overflow-wrap: anywhere; }
    p { color: #94a3b8; font-size: 0.8rem; line-height: 1.6; margin: 0; }
    .connection { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 0.75rem; text-align: center; }
    .connection span { color: #94a3b8; font-size: 0.75rem; line-height: 1.5; }
    .arrow { position: relative; width: 2px; height: 1rem; background: #6366f1; }
    .arrow::after { content: ""; position: absolute; bottom: 0; left: -3px; width: 8px; height: 8px; border-bottom: 2px solid #6366f1; border-right: 2px solid #6366f1; transform: rotate(45deg); }
    figcaption { margin-top: 1rem; text-align: center; color: #64748b; font: 0.75rem "JetBrains Mono", monospace; line-height: 1.6; }
    @media (max-width: 767px) { .nodes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 479px) { .nodes { grid-template-columns: minmax(0, 1fr); gap: 1rem; } .layer { padding: 1rem; } }
</style>
