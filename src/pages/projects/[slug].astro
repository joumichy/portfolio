---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import SystemArch from "../../components/diagrams/SystemArch.astro";
import UserFlow from "../../components/diagrams/UserFlow.astro";
import InfrastructureDiagram from "../../components/diagrams/InfrastructureDiagram.astro";
import Navbar from "../../components/Navbar.astro";
import { projects, type Project } from "../../data/projects";

interface Props {
    project: Project;
}

// Generate static paths for all projects
export async function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const capabilitiesSectionTitle = "What You Can Do";
---

<Layout title={`${project.title} | John Allou Portfolio`} description={project.description}>
    <Navbar />
    <div class="h-20"></div>

    <!-- Hero / Header -->
    <section class="relative py-20 bg-slate-900/30 border-b border-slate-800">
        <div class="container mx-auto px-4 relative z-10">
            <a
                href="/#projects"
                class="inline-flex items-center text-slate-400 hover:text-white mb-8 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mr-2"><path d="m15 18-6-6 6-6"></path></svg
                >
                Back to Projects
            </a>

            <div class="flex gap-4 mb-6">
                {project.tags.map((tag) => <Badge text={tag} color="sky" />)}
            </div>

            <h1
                class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight"
            >
                {project.title}
            </h1>

            {project.subtitle && (
                <p class="text-xl md:text-2xl text-indigo-300 mb-6">{project.subtitle}</p>
            )}

            <p class="text-xl text-slate-300 max-w-3xl leading-relaxed mb-8">
                {project.longDescription}
            </p>

            <div class="flex flex-wrap gap-4">
                {project.tech.map((t) => <Badge text={t} color="indigo" />)}
            </div>

            {
                project.projectUrl && (
                    <div class="mt-10">
                        <Button
                            href={project.projectUrl}
                            target="_blank"
                            variant="primary"
                        >
                            Visit Live Site
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="ml-2"
                            >
                                <path d="M7 17 17 7"></path>
                                <path d="M7 7h10v10"></path>
                            </svg>
                        </Button>
                    </div>
                )
            }
        </div>
    </section>

    {
        project.homepageImage && (
            <Section title="Homepage Preview" class="py-16">
                <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/30">
                    <img
                        src={project.homepageImage}
                        alt={project.homepageImageAlt ?? `${project.title} homepage preview`}
                        class="block w-full h-auto"
                        width="1440"
                        height="1000"
                        loading="lazy"
                    />
                </div>
            </Section>
        )
    }

    <!-- Problem & Solution Grid -->
    <Section class="py-16">
        <div class="grid md:grid-cols-2 gap-12">
            <div
                class="bg-slate-900/20 p-8 rounded-2xl border border-red-500/10"
            >
                <h2
                    class="text-2xl font-bold text-white mb-4 flex items-center gap-2"
                >
                    <span class="text-red-400">Problem</span>
                </h2>
                <p class="text-slate-400 leading-relaxed">{project.problem}</p>
            </div>
            <div
                class="bg-slate-900/20 p-8 rounded-2xl border border-emerald-500/10"
            >
                <h2
                    class="text-2xl font-bold text-white mb-4 flex items-center gap-2"
                >
                    <span class="text-emerald-400">Solution</span>
                </h2>
                <p class="text-slate-400 leading-relaxed">{project.solution}</p>
            </div>
        </div>
    </Section>

    {project.capabilities && (
        <Section title={capabilitiesSectionTitle}>
            <div class="grid md:grid-cols-2 gap-6">
                {project.capabilities.map((capability) => (
                    <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-6">
                        <h3 class="text-lg font-semibold text-white mb-3">{capability.title}</h3>
                        <p class="text-slate-400 leading-relaxed">{capability.description}</p>
                    </div>
                ))}
            </div>
        </Section>
    )}

    {project.contributions && (
        <Section title="My Contribution">
            <ul class="grid md:grid-cols-2 gap-x-12 gap-y-6">
                {project.contributions.map((contribution) => (
                    <li class="border-l-2 border-indigo-500 pl-5 text-slate-300 leading-relaxed">
                        {contribution}
                    </li>
                ))}
            </ul>
        </Section>
    )}

    {
        project.stackGroups && project.stackGroups.length > 0 && (
            <Section title="Full Stack & Infrastructure">
                <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
                    {project.stackGroups.map((group) => (
                        <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-6">
                            <h3 class="text-lg font-bold text-white mb-4">
                                {group.title}
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                {group.items.map((item) => (
                                    <Badge text={item} color="indigo" />
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </Section>
        )
    }

    {
        project.challenges && project.challenges.length > 0 && (
            <Section title="Technical Challenges" class="bg-slate-900/30">
                <div class="grid md:grid-cols-2 gap-6">
                    {project.challenges.map((challenge) => (
                        <div class="flex gap-4 rounded-lg border border-slate-800 bg-slate-950/50 p-6">
                            <div class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-400 shadow-lg shadow-amber-400/30" />
                            <p class="text-slate-400 leading-relaxed">
                                {challenge}
                            </p>
                        </div>
                    ))}
                </div>
            </Section>
        )
    }

    <!-- System Architecture -->
    <Section title="System Architecture" class="bg-slate-900/30">
        <div class:list={[project.architecture.infrastructure ? "space-y-10" : "grid lg:grid-cols-3 gap-12"]}>
            <div class:list={[project.architecture.infrastructure ? "grid md:grid-cols-2 gap-8" : "lg:col-span-1 space-y-6"]}>
                <p class="text-slate-400 leading-relaxed text-lg">
                    {project.architecture.description}
                </p>
                <div
                    class="p-6 bg-slate-950 rounded-xl border border-slate-800"
                >
                    <h3 class="text-white font-bold mb-4">Key Features</h3>
                    <ul class="space-y-3">
                        {
                            project.features.map((feature) => (
                                <li class="flex items-start text-slate-400 text-sm">
                                    <svg
                                        class="w-5 h-5 text-indigo-500 mr-2 shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    {feature}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
            <div class="lg:col-span-2">
                {project.architecture.infrastructure ? (
                    <InfrastructureDiagram id={project.slug} infrastructure={project.architecture.infrastructure} />
                ) : (
                    <>
                        <SystemArch type={project.architecture.diagramType} />
                        <div class="mt-4 text-center text-slate-500 text-sm font-mono">
                            Figure 1.0: {project.title} High-Level Architecture
                        </div>
                    </>
                )}
            </div>
        </div>

        {project.architecture.decisions && (
            <div class="grid md:grid-cols-2 gap-8 mt-12 pt-8 border-t border-slate-800">
                {project.architecture.decisions.map((decision) => (
                    <div>
                        <h3 class="text-lg font-semibold text-white mb-3">{decision.title}</h3>
                        <p class="text-sm text-slate-400 leading-relaxed">{decision.description}</p>
                    </div>
                ))}
            </div>
        )}
    </Section>

    <!-- User Flow -->
    <Section title="User Flow & Journey">
        <div class="grid lg:grid-cols-3 gap-12 items-start">
            <div class="lg:col-span-2">
                <UserFlow steps={project.userFlow.steps} />
            </div>
            <div class="lg:col-span-1 sticky top-24">
                <div
                    class="bg-gradient-to-br from-slate-900 to-slate-950 p-8 rounded-2xl border border-slate-800"
                >
                    <h3 class="text-xl font-bold text-white mb-4">
                        Flow Analysis
                    </h3>
                    <p class="text-slate-400 mb-6">
                        {project.userFlow.description}
                    </p>
                    <Button
                        href="/#contact"
                        variant="primary"
                        class="w-full justify-center"
                    >
                        Discuss this Project
                    </Button>
                </div>
            </div>
        </div>
    </Section>

    <!-- Navigation -->
    <div class="border-t border-slate-800 py-12">
        <div class="container mx-auto px-4 flex justify-between">
            <a
                href="/#projects"
                class="text-slate-400 hover:text-white transition-colors"
                >← Back to Projects</a
            >
            <a
                href="/#contact"
                class="text-indigo-400 hover:text-indigo-300 transition-colors"
                >Contact Me →</a
            >
        </div>
    </div>
</Layout>
